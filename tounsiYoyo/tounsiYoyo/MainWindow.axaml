<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="tounsiYoyo.MainWindow"
        Title="BackOffice"
        Width="827"
        Height="486"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <TextBlock Margin="23,16"
               FontSize="18"
               Text="{Binding FormattedDate}" />
    <TextBlock Margin="23,16"
               FontSize="18"
               FontWeight="SemiBold"
               HorizontalAlignment="Right"
               Text="{Binding ShopStatus}" />
    <ContentControl x:Name="BackofficeContent" Grid.Row="1" />
  </Grid>
</Window>
